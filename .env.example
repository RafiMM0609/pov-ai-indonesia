# ========================================
# POV AI Indonesia — Environment Variables
# ========================================
# Copy to .env and adjust values:
#   cp .env.example .env

# ==================== SERVER CONFIG ====================
PORT=8080
DATA_DIR=./data
KNOWLEDGE_DIR=./data/knowledge
DB_PATH=./data/povai.db
STATIC_DIR=./web/static
TEMPLATE_DIR=web/templates/*
CORS_ALLOW_ORIGIN=*

# ==================== REQUIRED ====================
# Get API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ==================== DATABASE POOL ====================
DB_MAX_OPEN_CONNS=1
DB_MAX_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME=60

# ==================== AI CLIENT ====================
POV_AI_MODEL=openrouter/owl-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_HTTP_TIMEOUT=120
AI_HTTP_REFERER=https://pov-ai.local
AI_HTTP_TITLE=POV AI Indonesia

# ==================== SCRAPER ====================
SCRAPE_INTERVAL=6
FRANKFURTER_BASE_URL=https://api.frankfurter.app
FRANKFURTER_START_DATE=2020-01-01
SCRAPER_HTTP_TIMEOUT=30
WEB_SCRAPER_ENABLED=true
SEARCH_TIMEOUT=10
SEARCH_ENGINE_URL=https://html.duckduckgo.com/html/
SEARCH_DOMAIN_FILTER=bisnis.com,cnbcindonesia.com

# ==================== CRON SCHEDULES ====================
# Standard cron: minute hour day month day-of-week
# Set "" to disable (e.g. CRON_GOV_DATA="")
CRON_AI_REFRESH=0 3 * * *
CRON_GOV_DATA=0 2 * * 0

# ==================== GOV API ====================
GOV_HTTP_TIMEOUT=30
BPS_BASE_URL=https://webapi.bps.go.id/v1
BI_BASE_URL=https://api.bi.go.id/v1
BMKG_BASE_URL=https://api.bmkg.go.id/publik
DATA_GO_BASE_URL=https://data.go.id/api/3
OJK_BASE_URL=https://api.ojk.go.id/v1
BPS_API_RATE_LIMIT=100
CKAN_API_RATE_LIMIT=200
OJK_ENABLED=false
BI_BI7DRR_RATE=5.50
BI_DEPOSIT_RATE=4.75
BI_LENDING_RATE=6.25

# ==================== SEED PRICE OVERRIDES ====================
# Uncomment to override default Pertamina prices
# SEED_PRICE_PERTALITE=10000
# SEED_PRICE_SOLAR=6800
# SEED_PRICE_PERTAMAX=16250
# SEED_PRICE_PERTAMAX_GREEN=17000
# SEED_PRICE_PERTAMAX_TURBO=20750
# SEED_PRICE_DEXLITE=23000
# SEED_PRICE_PERTAMINA_DEX=24800
